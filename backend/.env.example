# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/punto-park-u

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# CORS
CORS_ORIGIN=http://localhost:5173

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/oauth/google/callback

# Frontend URL (used for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Email Verification
# When true, unverified users cannot log in
STRICT_EMAIL_VERIFICATION=false

# Session Management
# Inactivity timeout in minutes (default: 30)
SESSION_TIMEOUT=30
# Activity heartbeat interval in minutes (default: 5)
ACTIVITY_HEARTBEAT_INTERVAL=5
# Session cleanup interval in minutes (default: 60)
SESSION_CLEANUP_INTERVAL=60

# QR Secret for HMAC-signed tickets (PR 3 — QR Entry/Exit)
QR_SECRET=your-qr-secret-here

# ePayco Sandbox (PR 2 — Real-time Operations & Payments)
# Get credentials from https://www.epayco.co/sandbox
# Set EPAYCO_ENABLED=true to use real sandbox; false = mock responses for dev
EPAYCO_ENABLED=false
EPAYCO_API_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_PUBLIC_KEY=
# Keep true for sandbox; set to false only for production
EPAYCO_TEST=true

# VAPID Keys for Web Push Notifications (PR 4)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@puntoparku.com
