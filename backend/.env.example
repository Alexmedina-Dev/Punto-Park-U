# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/punto-park-u

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# CORS
CORS_ORIGIN=http://localhost:5173

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/oauth/google/callback

# Frontend URL (used for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Email Verification
# When true, unverified users cannot log in
STRICT_EMAIL_VERIFICATION=false

# Session Management
# Inactivity timeout in minutes (default: 30)
SESSION_TIMEOUT=30
# Activity heartbeat interval in minutes (default: 5)
ACTIVITY_HEARTBEAT_INTERVAL=5
# Session cleanup interval in minutes (default: 60)
SESSION_CLEANUP_INTERVAL=60
