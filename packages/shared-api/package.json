{
  "name": "@punto-park-u/shared-api",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API services and Axios instance for Punto Park U",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "socket.io-client": "^4.8.3"
  },
  "peerDependencies": {
    "@punto-park-u/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@punto-park-u/shared-types": "workspace:*",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
