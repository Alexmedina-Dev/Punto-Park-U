# ═══════════════════════════════════════════
# Punto Park U — Environment Variables
# ═══════════════════════════════════════════

# Backend API base URL
VITE_API_URL=http://localhost:3000/api

# Application name
VITE_APP_NAME=Punto Park U

# Session Management
# Inactivity timeout in minutes (30 min default)
VITE_SESSION_TIMEOUT=30
# Activity heartbeat interval in minutes (5 min default)
VITE_ACTIVITY_HEARTBEAT_INTERVAL=5

# ── RBAC Admin ──
# On first startup, this email address will be assigned the admin role
ADMIN_EMAIL=admin@puntoparku.com
